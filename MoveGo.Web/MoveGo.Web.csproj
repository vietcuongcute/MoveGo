<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MoveGo.Web</RootNamespace>
  </PropertyGroup>

  <!-- Không cần NuGet package nào thêm: MVC + HttpClient đã có sẵn trong .NET -->

  <ItemGroup>
    <!-- Node chỉ dùng để build Tailwind, không đưa vào bản publish -->
    <Content Remove="node_modules/**" />
    <None Remove="node_modules/**" />
    <Compile Remove="node_modules/**" />
  </ItemGroup>

  <!--
    Chế độ GỘP API vào website (để up lên host chỉ có 1 website, ví dụ MonsterASP gói Free):
      dotnet publish MoveGo.Web -c Release -p:EmbedApi=true -o publish
    Khi không có EmbedApi, hai dự án vẫn chạy riêng như bình thường.
  -->
  <!-- "dotnet publish" mặc định gộp API (để Git deploy của MonsterASP chạy được 1 website). Build/chạy khi lập trình vẫn tách 2 dự án. Tắt bằng -p:EmbedApi=false -->
  <PropertyGroup Condition="'$(EmbedApi)' == '' And '$(_IsPublishing)' == 'true'">
    <EmbedApi>true</EmbedApi>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EmbedApi)' == 'true'">
    <DefineConstants>$(DefineConstants);EMBED_API</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EmbedApi)' == 'true'">
    <Compile Include="..\MoveGo.API\**\*.cs" Exclude="..\MoveGo.API\Program.cs;..\MoveGo.API\obj\**;..\MoveGo.API\bin\**" LinkBase="_Api" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.*" />
    <!-- Cấu hình mặc định của API (Business, Seed, Zalo, PayOs...) đi kèm bản gộp; appsettings.Production.json ghi đè lên -->
    <None Include="..\MoveGo.API\appsettings.json" Link="appsettings.api.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
