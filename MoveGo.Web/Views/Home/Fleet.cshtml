@model HomeViewModel
@inject IOptions<SiteOptions> SiteOpt
@{
    ViewData["Title"] = "Xe cho thuê";
    ViewData["Description"] = "Chọn ô tô điện, xe máy điện còn trống theo ngày bạn cần. Gửi yêu cầu cho chủ xe, cọc chỉ 10%.";
    ViewData["Nav"] = "fleet";
    ViewData["BannerIcon"] = "fa-car-side";
    ViewData["BannerEyebrow"] = "Đội xe Move-Go";
    ViewData["BannerTitle"] = Model.HasSearch ? "Xe còn trống" : "Chọn xe hợp với";
    ViewData["BannerAccent"] = Model.HasSearch ? "cho chuyến đi của bạn" : "chuyến đi của bạn";
    ViewData["BannerSub"] = "Lọc theo loại xe, điểm nhận và ngày giờ. Xe đã có người đặt hoặc chủ xe khoá lịch sẽ tự ẩn đi.";
    ViewData["DepositPercent"] = Model.Meta.Stats.DepositPercent;
    var site = SiteOpt.Value;
    var meta = Model.Meta;
    var vehicles = Model.AvailableVehicles;
    var depositPct = meta.Stats.DepositPercent;
    var selectedCategory = Model.Search.Category?.ToString() ?? "";
    int CountOf(string key) => key == "" ? vehicles.Count : vehicles.Count(v => v.Category.ToString() == key);
}

@section Scripts {
    <script>window.MOVEGO.data = @Json.Serialize(ViewHelpers.BookingData(Model, vehicles));</script>
    <script src="~/js/booking.js" asp-append-version="true"></script>
}

<partial name="_PageBanner" />

<section id="search" class="relative z-20 -mt-28 pb-2">
    <div class="container-x">
        <partial name="_SearchForm" model="Model" />
    </div>
</section>

<section id="fleet" class="section !pt-14">
    <div class="pointer-events-none absolute right-0 top-10 -z-10 h-96 w-96 rounded-full bg-cyan-200/40 blur-3xl"></div>
    <div class="container-x">
        <div class="flex flex-wrap items-end justify-between gap-6">
            <div class="max-w-2xl">
                <span class="eyebrow reveal"><i class="fa-solid fa-car-side"></i> Đội xe</span>
                <h2 class="section-title reveal" style="--d:.1s">
                    @(Model.HasSearch ? "Xe còn trống cho chuyến đi của bạn" : "Chọn xe hợp với chuyến đi")
                </h2>
            </div>
            <div class="reveal" style="--d:.2s">
                <div class="filter-tabs" id="filter-tabs" role="tablist" aria-label="Lọc theo loại xe">
                    <span class="filter-pill" id="filter-pill"></span>
                    @foreach (var c in ViewHelpers.Categories)
                    {
                        <button type="button" role="tab" class="filter-tab @(selectedCategory == c.Key ? "is-active" : "")" data-filter="@(c.Key == "" ? "all" : c.Key)">
                            @c.Label <span class="count">@CountOf(c.Key)</span>
                        </button>
                    }
                </div>
            </div>
        </div>

        @if (Model.HasSearch && Model.SearchStart is DateTime ss && Model.SearchEnd is DateTime se)
        {
            <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm text-emerald-900 reveal">
                <span class="grid h-9 w-9 place-items-center rounded-full bg-emerald-500 text-white"><i class="fa-solid fa-calendar-check"></i></span>
                <span>
                    <b>@vehicles.Count xe</b> còn trống từ <b>@ViewHelpers.ShortDateTimeVn(ss)</b> đến <b>@ViewHelpers.ShortDateTimeVn(se)</b>
                    @if (!string.IsNullOrEmpty(Model.Search.Location)) { <span> · tại <b>@Model.Search.Location</b></span> }
                </span>
                <a href="@Url.Action("Fleet", "Home")" class="ml-auto font-bold text-emerald-700 underline-offset-4 hover:underline"><i class="fa-solid fa-rotate-left"></i> Xoá bộ lọc</a>
            </div>
        }

        @if (Model.ApiError != null)
        {
            <div class="mt-12 rounded-3xl border border-amber-200 bg-amber-50 p-8 text-center">
                <i class="fa-solid fa-plug-circle-exclamation text-3xl text-amber-500"></i>
                <p class="mt-3 font-semibold text-amber-800">@Model.ApiError</p>
            </div>
        }
        else
        {
            <div id="fleet-grid" class="mt-10 grid gap-7 sm:grid-cols-2 xl:grid-cols-3">
                @for (var i = 0; i < vehicles.Count; i++)
                {
                    <partial name="_VehicleCard" model="vehicles[i]" view-data="@(new ViewDataDictionary(ViewData) { { "HasSearch", Model.HasSearch }, { "Delay", i % 3 } })" />
                }
            </div>

            <div id="fleet-empty" class="@(vehicles.Count == 0 ? "" : "hidden") mt-12 rounded-4xl border border-dashed border-emerald-200 bg-emerald-50/50 p-12 text-center">
                <div class="mx-auto w-48 opacity-80" style="color:#94a3b8"><svg class="art" viewBox="0 0 360 170"><use href="#art-car" /></svg></div>
                <h3 class="mt-4 text-xl font-extrabold">Chưa có xe phù hợp</h3>
                <p class="mx-auto mt-2 max-w-md text-sm text-slate-500">
                    @(Model.HasSearch ? "Rất tiếc, không còn xe trống trong khoảng thời gian này. Hãy thử đổi ngày, địa điểm hoặc loại xe khác." : "Hiện chưa có xe nào thuộc nhóm này.")
                </p>
                <a href="#search" class="btn-primary mt-6"><i class="fa-solid fa-rotate-left"></i> Tìm lại</a>
            </div>
        }
    </div>
</section>

<partial name="_BookingModal" />
