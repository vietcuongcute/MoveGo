@model HomeViewModel
@inject IOptions<SiteOptions> SiteOpt
@{
    ViewData["Title"] = null;
    ViewData["HeaderMode"] = "overlay";
    ViewData["Nav"] = "home";
    ViewData["DepositPercent"] = Model.Meta.Stats.DepositPercent;
    var site = SiteOpt.Value;
    var meta = Model.Meta;
    var depositPct = meta.Stats.DepositPercent;

    // Xe nổi bật: mỗi loại xe lấy 1 chiếc rẻ nhất, tối đa 3 chiếc
    var vehicles = Model.AvailableVehicles
        .GroupBy(v => v.Category).Select(g => g.OrderBy(v => v.PricePerDay).First())
        .Take(3).ToList();
}

@section Scripts {
    <script>window.MOVEGO.data = @Json.Serialize(ViewHelpers.BookingData(Model, vehicles));</script>
    <script src="~/js/booking.js" asp-append-version="true"></script>
}

@* ======================= HERO ======================= *@
<section id="top" class="relative isolate overflow-hidden text-white">
    <partial name="_HeroScene" />

    <div class="container-x relative pb-6 pt-28 sm:pt-32 lg:pb-40">
        <div class="max-w-2xl lg:max-w-[48%] xl:max-w-[50%]">
            <span class="eyebrow eyebrow-light anim-rise"><i class="fa-solid fa-leaf"></i> Thuê xe điện · Ô tô &amp; xe máy</span>

            <h1 class="mt-6 text-[2.9rem] font-extrabold leading-[.95] tracking-tight !text-white sm:text-7xl xl:text-[5.4rem]">
                <span class="block anim-rise" style="--d:.1s">MOVE GREEN</span>
                <span class="relative mt-1 block anim-rise" style="--d:.25s">
                    <span class="bg-gradient-to-r from-white via-emerald-100 to-cyan-200 bg-clip-text text-transparent">GO AMAZING</span>
                    <svg class="absolute -bottom-2 left-0 h-3 w-[78%] text-emerald-300" viewBox="0 0 300 12" fill="none" preserveAspectRatio="none">
                        <path d="M2 8 C 60 1, 130 1, 200 6 S 280 9, 298 3" stroke="currentColor" stroke-width="4" stroke-linecap="round" style="stroke-dasharray:320;stroke-dashoffset:320;animation:draw 1.4s .9s ease forwards" />
                    </svg>
                </span>
            </h1>

            <p class="mt-8 max-w-xl text-lg leading-relaxed text-emerald-50/95 anim-rise" style="--d:.4s">
                Thuê ô tô điện &amp; xe máy điện trực tiếp từ chủ xe. Gửi yêu cầu trong 60 giây, chủ xe xác nhận qua Zalo,
                cọc chỉ <b class="text-white">@depositPct%</b> — bàn giao xe ngay.
            </p>

            <div class="mt-9 flex flex-wrap items-center gap-4 anim-rise" style="--d:.55s">
                <a href="#search" class="btn-primary btn-lg"><i class="fa-solid fa-magnifying-glass-location"></i> Tìm xe trống</a>
                <a href="@Url.Action("Process", "Home")" class="btn-outline btn-lg"><i class="fa-solid fa-circle-play"></i> Cách hoạt động</a>
            </div>

            <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-3 text-sm font-semibold text-white anim-rise [text-shadow:0_1px_12px_rgb(2_44_34_/_.6)]" style="--d:.7s">
                <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-emerald-300"></i> Không cần tạo tài khoản</li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-emerald-300"></i> Chủ xe phản hồi qua Zalo</li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-emerald-300"></i> Giá minh bạch</li>
            </ul>
        </div>
    </div>

    @* Xe điện chạy vào cảnh, đỗ trên con đường ở chân hero *@
    <div class="relative z-[1] mx-auto mb-[6.8rem] mt-4 w-[88%] max-w-md lg:absolute lg:bottom-[6.2rem] lg:right-[4%] lg:mb-0 lg:mt-0 lg:w-[46%] lg:max-w-[44rem] xl:right-[7%]">
        <div id="hero-car" class="hero-car relative">
            <div class="car-beam"></div>
            <div style="color:#10b981"><svg class="art" viewBox="0 0 360 170" role="img" aria-label="Ô tô điện Move-Go"><use href="#art-car" /></svg></div>
        </div>
        <div class="absolute -bottom-1 left-[8%] right-[3%] h-5 rounded-full bg-black/40 blur-md"></div>

        <div class="hero-chip glass-dark absolute -top-14 left-0 flex items-center gap-3 rounded-2xl px-4 py-3 text-sm text-white sm:left-[10%]" style="animation-delay:-1s">
            <span class="grid h-9 w-9 place-items-center rounded-xl bg-emerald-400 text-white"><i class="fa-solid fa-bolt"></i></span>
            <span><b class="block leading-tight">100% điện</b><span class="text-xs text-emerald-100/80">Êm · sạch · tiết kiệm</span></span>
        </div>
        <div class="hero-chip glass-dark absolute -top-16 right-0 hidden items-center gap-3 rounded-2xl px-4 py-3 text-sm text-white sm:flex" style="animation-delay:-3s">
            <span class="grid h-9 w-9 place-items-center rounded-xl bg-[#0068ff] text-[11px] font-extrabold text-white">Zalo</span>
            <span><b class="block leading-tight">Xác nhận nhanh</b><span class="text-xs text-emerald-100/80">Chủ xe nhận tin ngay</span></span>
        </div>
    </div>
</section>

@* ======================= FORM TÌM XE (nổi lên trên hero) ======================= *@
<section id="search" class="relative z-20 -mt-20 pb-6">
    <div class="container-x">
        <partial name="_SearchForm" model="Model" />
    </div>
</section>

@* ======================= SỐ LIỆU ======================= *@
<section class="py-14 sm:py-16" aria-label="Số liệu">
    <div class="container-x">
        <dl class="grid grid-cols-2 gap-y-10 lg:grid-cols-4">
            @{
                var stats = new[]
                {
                    (Value: meta.Stats.Vehicles, Suffix: "", Label: "Xe sẵn sàng cho thuê", Icon: "fa-car-on"),
                    (Value: meta.Stats.Locations, Suffix: "", Label: "Địa điểm nhận xe", Icon: "fa-map-location-dot"),
                    (Value: depositPct, Suffix: "%", Label: "Cọc online, phần còn lại trả chủ xe", Icon: "fa-percent"),
                    (Value: meta.DepositHoldMinutes, Suffix: "′", Label: "Giữ chỗ chờ bạn đặt cọc", Icon: "fa-hourglass-half")
                };
            }
            @for (var i = 0; i < stats.Length; i++)
            {
                var s = stats[i];
                <div class="reveal text-center @(i > 0 ? "lg:border-l lg:border-emerald-900/10" : "")" style="--d:@(i * 0.1)s">
                    <i class="fa-solid @s.Icon mb-3 text-xl text-emerald-500"></i>
                    <dd class="text-4xl font-extrabold tracking-tight text-ink-900 sm:text-5xl"><span class="text-gradient" data-count="@s.Value">0</span><span class="text-gradient">@s.Suffix</span></dd>
                    <dt class="mx-auto mt-2 max-w-[11rem] text-sm font-medium text-slate-500">@s.Label</dt>
                </div>
            }
        </dl>
    </div>
</section>

@* ======================= LÝ DO CHỌN MOVE-GO ======================= *@
<section class="section bg-gradient-to-b from-emerald-50/70 to-white">
    <div class="container-x">
        <div class="mx-auto max-w-2xl text-center">
            <span class="eyebrow reveal"><i class="fa-solid fa-sparkles"></i> Vì sao chọn Move-Go</span>
            <h2 class="section-title reveal" style="--d:.1s">Thuê xe điện chưa bao giờ <span class="text-gradient">dễ đến vậy</span></h2>
            <p class="section-sub mx-auto reveal" style="--d:.2s">Kết nối trực tiếp với chủ xe, minh bạch từng bước — từ lúc chọn xe đến lúc cầm chìa khoá.</p>
        </div>

        <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            @{
                var features = new[]
                {
                    (Icon: "fa-bolt", Title: "Xe điện êm, tiết kiệm", Text: "Không xăng, không khói. Chi phí mỗi km thường thấp hơn xe xăng và đi phố cực kỳ dễ chịu."),
                    (Icon: "fa-comment-dots", Title: "Chủ xe xác nhận qua Zalo", Text: "Yêu cầu của bạn đến thẳng Zalo chủ xe. Chủ xe bấm Chấp nhận là xe được giữ chỗ cho bạn."),
                    (Icon: "fa-shield-halved", Title: $"Cọc {depositPct}% minh bạch", Text: $"Chỉ cọc {depositPct}% qua QR sau khi chủ xe đồng ý. {100 - depositPct}% còn lại trả trực tiếp khi nhận xe."),
                    (Icon: "fa-calendar-check", Title: "Lịch xe thời gian thực", Text: "Xe đã có người đặt hoặc chủ xe khoá lịch sẽ tự biến mất khỏi kết quả — không lo đặt trùng.")
                };
            }
            @for (var i = 0; i < features.Length; i++)
            {
                var f = features[i];
                <article class="feature-card reveal" style="--d:@(i * 0.12)s" data-glow>
                    <div class="feature-icon"><i class="fa-solid @f.Icon"></i></div>
                    <h3 class="mt-6 text-lg font-extrabold">@f.Title</h3>
                    <p class="mt-3 text-sm leading-relaxed text-slate-500">@f.Text</p>
                </article>
            }
        </div>
    </div>
</section>

@* ======================= XE NỔI BẬT ======================= *@
<section class="section">
    <div class="container-x">
        <div class="flex flex-wrap items-end justify-between gap-6">
            <div class="max-w-2xl">
                <span class="eyebrow reveal"><i class="fa-solid fa-car-side"></i> Xe nổi bật</span>
                <h2 class="section-title reveal" style="--d:.1s">Vài chiếc <span class="text-gradient">đang được thuê nhiều</span></h2>
            </div>
            <a href="@Url.Action("Fleet", "Home")" class="btn-outline-dark reveal" style="--d:.2s">Xem tất cả xe <i class="fa-solid fa-arrow-right"></i></a>
        </div>

        @if (Model.ApiError != null)
        {
            <div class="mt-12 rounded-3xl border border-amber-200 bg-amber-50 p-8 text-center">
                <i class="fa-solid fa-plug-circle-exclamation text-3xl text-amber-500"></i>
                <p class="mt-3 font-semibold text-amber-800">@Model.ApiError</p>
            </div>
        }
        else
        {
            <div id="fleet-grid" class="mt-10 grid gap-7 sm:grid-cols-2 xl:grid-cols-3">
                @for (var i = 0; i < vehicles.Count; i++)
                {
                    <partial name="_VehicleCard" model="vehicles[i]" view-data="@(new ViewDataDictionary(ViewData) { { "HasSearch", false }, { "Delay", i % 3 } })" />
                }
            </div>
        }
    </div>
</section>

@* ======================= LỐI TẮT SANG CÁC TRANG ======================= *@
<section class="pb-16 pt-2">
    <div class="container-x">
        <div class="grid gap-6 md:grid-cols-3">
            @{
                var shortcuts = new[]
                {
                    (Icon: "fa-calculator", Title: "Tính giá tức thì", Text: $"Chọn xe, kéo số ngày: biết ngay tổng tiền, khoản cọc {depositPct}% và phần trả trực tiếp cho chủ xe.", Url: Url.Action("Pricing", "Home")!, Cta: "Mở máy tính giá"),
                    (Icon: "fa-route", Title: "Thuê xe trong 3 bước", Text: "Gửi yêu cầu, chủ xe xác nhận qua Zalo, cọc rồi nhận xe. Không cần tạo tài khoản.", Url: Url.Action("Process", "Home")!, Cta: "Xem quy trình"),
                    (Icon: "fa-circle-question", Title: "Câu hỏi thường gặp", Text: "Thanh toán thế nào, giấy tờ cần mang gì, đăng ký làm chủ xe ra sao.", Url: Url.Action("Faq", "Home")!, Cta: "Xem giải đáp")
                };
            }
            @for (var i = 0; i < shortcuts.Length; i++)
            {
                var sc = shortcuts[i];
                <a href="@sc.Url" class="feature-card reveal group block" style="--d:@(i * 0.12)s" data-glow>
                    <div class="feature-icon"><i class="fa-solid @sc.Icon"></i></div>
                    <h3 class="mt-6 text-lg font-extrabold">@sc.Title</h3>
                    <p class="mt-3 text-sm leading-relaxed text-slate-500">@sc.Text</p>
                    <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-emerald-600">@sc.Cta <i class="fa-solid fa-arrow-right transition group-hover:translate-x-1"></i></span>
                </a>
            }
        </div>
    </div>
</section>

<partial name="_OwnerCta" />

<partial name="_BookingModal" />
