@model AdminVehiclesViewModel
@{
    ViewData["Title"] = "Quản trị · Xe";
    ViewData["AdminTab"] = "vehicles";
    var vehicles = Model.Vehicles;
    var today = ViewHelpers.VnNow();
    var winStart = today.Date;
    const int WinDays = 30;
    var winEnd = winStart.AddDays(WinDays);
    string Dt(DateTime d) => d.ToString("dd/MM HH:mm");
    string Pos(DateTime d) => (Math.Clamp((d - winStart).TotalHours / (WinDays * 24.0), 0, 1) * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
    string Wid(DateTime a, DateTime b)
    {
        var s0 = a < winStart ? winStart : a; var e0 = b > winEnd ? winEnd : b;
        var w = Math.Max((e0 - s0).TotalHours / (WinDays * 24.0) * 100, 1.2);
        return w.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }
    string SegCls(AdminScheduleEntryDto e) => e.Kind == "block" ? "bg-slate-500"
        : e.Status == BookingStatus.PendingOwner ? "bg-amber-300 ring-1 ring-inset ring-amber-500"
        : e.Status == BookingStatus.AwaitingDeposit ? "bg-blue-400" : "bg-emerald-500";
}
<section class="page-banner pb-36 pt-28 sm:pt-32">
    <div class="container-x relative">
        <span class="eyebrow eyebrow-light"><i class="fa-solid fa-car-side"></i> Quản trị</span>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight !text-white sm:text-5xl anim-rise">Quản lý xe</h1>
        <p class="mt-3 max-w-2xl text-emerald-50/80 anim-rise" style="--d:.1s">Xem từng xe đang cho thuê hay trống, ngày nào có khách, ngày nào chủ xe khoá. Thêm, sửa, ẩn hoặc xoá xe khi cần.</p>
    </div>
</section>

<section class="container-x relative z-10 -mt-24 pb-24">
    <partial name="_AdminNav" />

    <div class="panel">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-xl font-extrabold">@vehicles.Count xe <span class="text-sm font-semibold text-slate-400">· @vehicles.Count(v => v.IsActive) đang hiện trên web · @Model.Schedules.Values.Count(x => x.RentedNow) đang cho thuê</span></h2>
            <a href="@Url.Action("NewVehicle", "Admin")" class="btn-primary btn-sm"><i class="fa-solid fa-plus"></i> Thêm xe</a>
        </div>

        @if (vehicles.Count == 0)
        {
            <p class="mt-6 rounded-2xl bg-slate-50 p-6 text-center text-sm text-slate-400">Chưa có xe nào. Hãy <a class="font-bold text-emerald-600" href="@Url.Action("Owners", "Admin")">thêm chủ xe</a> trước rồi thêm xe.</p>
        }
        else
        {
            <div class="mt-5 divide-y divide-slate-100 overflow-hidden rounded-2xl border border-slate-100">
                @foreach (var v in vehicles)
                {
                    Model.Schedules.TryGetValue(v.Id, out var sch);
                    <div class="bg-white @(v.IsActive ? "" : "bg-slate-50/70")">
                    <div class="grid gap-3 p-4 text-sm md:grid-cols-[4.5rem_1fr_auto] md:items-center">
                        <div class="grid h-16 w-[4.5rem] place-items-center overflow-hidden rounded-2xl bg-emerald-50 text-2xl text-emerald-500">
                            @if (v.Images is { Length: > 0 } imgs) { <img src="@imgs[0]" alt="" class="h-full w-full object-cover" loading="lazy" /> }
                            else { <i class="fa-solid @ViewHelpers.CategoryIcon(v.Category)"></i> }
                        </div>
                        <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-2">
                                <b class="text-base">@v.Name</b>
                                <span class="status-pill !py-1 @(v.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-500")">@(v.IsActive ? "Đang hiện" : "Đang ẩn")</span>
                                @if (v.Images is { Length: > 0 } cnt) { <span class="status-pill !py-1 bg-slate-100 text-slate-500"><i class="fa-regular fa-images"></i> @cnt.Length ảnh</span> }
                                @if (v.ActiveBookings > 0) { <span class="status-pill !py-1 bg-amber-50 text-amber-700">@v.ActiveBookings đơn đang chạy</span> }
                            </div>
                            <div class="mt-1 text-slate-500">@v.CategoryLabel · @v.Seats chỗ · <b class="text-ink-900 tabular">@ViewHelpers.Vnd(v.PricePerDay)</b>/ngày</div>
                            <div class="text-xs text-slate-400">Chủ xe: @v.OwnerName</div>
                            @if (sch is not null)
                            {
                                <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
                                    @if (sch.RentedNow)
                                    {
                                        <span class="status-pill !py-1 bg-emerald-600 text-white"><i class="fa-solid fa-key"></i> Đang cho thuê · đến @Dt(sch.RentedUntil!.Value)</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill !py-1 bg-slate-100 text-slate-600"><i class="fa-regular fa-circle-check"></i> Đang trống</span>
                                    }
                                    @if (sch.NextBusyFrom is { } nb) { <span class="status-pill !py-1 bg-sky-50 text-sky-700"><i class="fa-regular fa-calendar"></i> Lịch bận kế tiếp: @Dt(nb)</span> }
                                    @if (sch.UpcomingCount > 0) { <span class="status-pill !py-1 bg-emerald-50 text-emerald-700">@sch.UpcomingCount đơn sắp tới</span> }
                                    @if (sch.PendingCount > 0) { <span class="status-pill !py-1 bg-amber-50 text-amber-700">@sch.PendingCount đơn chờ chủ xe</span> }
                                    @if (sch.TripsDone > 0) { <span class="status-pill !py-1 bg-slate-100 text-slate-500">@sch.TripsDone chuyến đã chạy</span> }
                                </div>
                            }
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <a href="@Url.Action("EditVehicle", "Admin", new { id = v.Id })" class="btn-outline-dark btn-sm"><i class="fa-solid fa-pen"></i> Sửa</a>
                            <form method="post" asp-controller="Admin" asp-action="ToggleVehicle" asp-route-id="@v.Id">
                                <input type="hidden" name="active" value="@((!v.IsActive).ToString().ToLowerInvariant())" />
                                <button type="submit" class="btn-outline-dark btn-sm"><i class="fa-solid @(v.IsActive ? "fa-eye-slash" : "fa-eye")"></i> @(v.IsActive ? "Ẩn" : "Hiện")</button>
                            </form>
                            <form method="post" asp-controller="Admin" asp-action="DeleteVehicle" asp-route-id="@v.Id"
                                  data-confirm="Xoá xe “@v.Name”? Xe sẽ biến mất khỏi web và danh sách này, không hoàn tác được.@(v.ActiveBookings > 0 ? " Xe đang có đơn chạy nên sẽ không xoá được, hãy ẩn xe trước." : "")">
                                <button type="submit" class="btn-outline-dark btn-sm !border-red-200 !text-red-500 hover:!border-red-400 hover:!bg-red-50 hover:!text-red-600"><i class="fa-solid fa-trash-can"></i> Xoá</button>
                            </form>
                        </div>
                    </div>

                    @if (sch is not null)
                    {
                        var upcoming = sch.Entries.Where(e => e.Phase != "past").ToList();
                        var past = sch.Entries.Where(e => e.Phase == "past").OrderByDescending(e => e.StartDate).ToList();
                        <details class="group border-t border-slate-100 bg-slate-50/60 px-4 py-3 text-sm" @(sch.RentedNow || upcoming.Count > 0 ? "open" : "")>
                            <summary class="flex cursor-pointer list-none items-center gap-2 font-bold text-slate-700">
                                <i class="fa-regular fa-calendar-days text-emerald-600"></i> Lịch thuê của xe
                                <span class="text-xs font-semibold text-slate-400">· @upcoming.Count đang/sắp tới · @past.Count đã qua (90 ngày)</span>
                                <i class="fa-solid fa-chevron-down ml-auto text-xs text-slate-400 transition group-open:rotate-180"></i>
                            </summary>

                            <div class="mt-3 text-xs font-semibold text-slate-500">30 ngày tới (từ @winStart.ToString("dd/MM"))</div>
                            <div class="relative mt-1 h-7 overflow-hidden rounded-lg bg-white ring-1 ring-slate-200">
                                @for (var d = 0; d < WinDays; d++)
                                {
                                    <span class="absolute inset-y-0 border-l @(winStart.AddDays(d).DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? "border-slate-200 bg-slate-50" : "border-slate-100")" style="left:@Pos(winStart.AddDays(d)); width:@((100.0 / WinDays).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                }
                                @foreach (var e in sch.Entries.Where(e => e.EndDate > winStart && e.StartDate < winEnd))
                                {
                                    <span class="absolute inset-y-1 rounded-md @SegCls(e)" style="left:@Pos(e.StartDate); width:@Wid(e.StartDate, e.EndDate)" title="@(e.Kind == "block" ? e.Label : e.Code + " · " + e.CustomerName) · @Dt(e.StartDate) → @Dt(e.EndDate)"></span>
                                }
                                <span class="absolute inset-y-0 w-0.5 bg-red-500" style="left:@Pos(today)" title="Bây giờ"></span>
                            </div>
                            <div class="mt-1 flex justify-between text-[10px] text-slate-400 tabular">
                                @foreach (var d in new[] { 0, 7, 14, 21, 29 }) { <span>@winStart.AddDays(d).ToString("dd/MM")</span> }
                            </div>
                            <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-slate-500">
                                <span><i class="mr-1 inline-block h-2.5 w-2.5 rounded bg-emerald-500"></i>Đã cọc</span>
                                <span><i class="mr-1 inline-block h-2.5 w-2.5 rounded bg-blue-400"></i>Giữ chỗ, chờ cọc</span>
                                <span><i class="mr-1 inline-block h-2.5 w-2.5 rounded bg-amber-300 ring-1 ring-amber-500"></i>Chờ chủ xe (chưa chiếm xe)</span>
                                <span><i class="mr-1 inline-block h-2.5 w-2.5 rounded bg-slate-500"></i>Chủ xe khoá</span>
                                <span><i class="mr-1 inline-block h-2.5 w-0.5 bg-red-500"></i>Hiện tại</span>
                            </div>

                            @if (upcoming.Count == 0)
                            {
                                <p class="mt-3 rounded-xl bg-white p-3 text-center text-slate-400">Chưa có lịch nào sắp tới — xe đang trống hoàn toàn.</p>
                            }
                            else
                            {
                                <div class="mt-3 grid gap-2">
                                    @foreach (var e in upcoming) { <partial name="_AdminScheduleRow" model="e" /> }
                                </div>
                            }

                            @if (past.Count > 0)
                            {
                                <details class="mt-3">
                                    <summary class="cursor-pointer text-xs font-bold text-slate-500">Lịch sử gần đây (@past.Count)</summary>
                                    <div class="mt-2 grid gap-2 opacity-80">
                                        @foreach (var e in past) { <partial name="_AdminScheduleRow" model="e" /> }
                                    </div>
                                </details>
                            }
                        </details>
                    }
                    </div>
                }
            </div>
        }
    </div>
</section>
