@inject IOptions<SiteOptions> SiteOpt
@{ var site = SiteOpt.Value; }
<section class="px-5 pb-20 pt-6 sm:px-8">
    <div class="relative mx-auto max-w-7xl overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-emerald-500 via-emerald-600 to-cyan-600 p-8 text-white sm:p-14 reveal" data-reveal="zoom">
        <div class="absolute -right-20 -top-20 h-80 w-80 rounded-full bg-white/10 blur-2xl animate-float-slow"></div>
        <div class="absolute -bottom-24 left-1/3 h-72 w-72 rounded-full bg-cyan-300/20 blur-2xl"></div>
        <div class="relative grid items-center gap-10 lg:grid-cols-2">
            <div>
                <span class="eyebrow eyebrow-light"><i class="fa-solid fa-key"></i> Dành cho chủ xe</span>
                <h2 class="mt-5 text-3xl font-extrabold !text-white sm:text-4xl">Xe đang nằm không? <br class="hidden sm:block" />Cho thuê cùng MoveGo.</h2>
                <p class="mt-4 max-w-lg text-emerald-50/90">Nhận yêu cầu thẳng qua Zalo, tự quyết định nhận hay từ chối, tự khoá lịch những ngày xe bận. MoveGo chỉ thu phí khi chuyến đi được xác nhận.</p>
                <div class="mt-8 flex flex-wrap gap-4">
                    <a href="https://zalo.me/@site.ZaloPhone" target="_blank" rel="noopener" class="btn-white btn-lg"><span class="font-extrabold text-[#0068ff]">Zalo</span> Đăng ký làm chủ xe</a>
                    <a href="tel:@(new string(site.Hotline.Where(char.IsDigit).ToArray()))" class="btn-outline btn-lg"><i class="fa-solid fa-phone"></i> @site.Hotline</a>
                </div>
            </div>
            <div class="relative mx-auto w-full max-w-md">
                <div class="animate-float" style="color:#ecfdf5;--wheel-state:running;--spin:2s"><svg class="art" viewBox="0 0 360 170"><use href="#art-van" /></svg></div>
                <div class="mx-auto mt-1 h-4 w-[80%] rounded-full bg-black/25 blur-md"></div>
            </div>
        </div>
    </div>
</section>
