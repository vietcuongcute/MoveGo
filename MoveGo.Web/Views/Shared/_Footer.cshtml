@inject IWebHostEnvironment Env
@inject IOptions<SiteOptions> SiteOpt
@{
    var site = SiteOpt.Value;
    var tel = new string(site.Hotline.Where(char.IsDigit).ToArray());
    var home = Url.Action("Index", "Home");
}
<footer class="relative overflow-hidden bg-ink-950 text-slate-400">
    <div class="pointer-events-none absolute -left-24 top-0 h-72 w-72 rounded-full bg-emerald-500/20 blur-3xl"></div>
    <div class="pointer-events-none absolute -right-24 bottom-0 h-72 w-72 rounded-full bg-cyan-500/15 blur-3xl"></div>
    <div class="container-x relative grid gap-12 py-16 md:grid-cols-12">
        <div class="md:col-span-5">
            <div class="flex items-center gap-2.5">
                <img src="~/brand/logo-mark.svg" alt="" width="44" height="44" class="h-11 w-11 rounded-2xl" />
                <span class="text-xl font-extrabold text-white">Move<span class="text-emerald-300">Go</span></span>
            </div>
            <p class="mt-5 max-w-sm text-sm leading-relaxed">
                Nền tảng kết nối khách thuê với chủ xe: ô tô điện, xe máy điện. MoveGo là bên trung gian, thu phí dịch vụ @((ViewData["DepositPercent"] as int?) ?? 10)% qua tiền cọc; phần còn lại bạn thanh toán trực tiếp cho chủ xe.
            </p>
            <div class="mt-6 flex gap-3">
                <a href="https://zalo.me/@site.ZaloPhone" target="_blank" rel="noopener" class="grid h-11 w-11 place-items-center rounded-full bg-white/5 text-sm font-extrabold text-white transition hover:-translate-y-1 hover:bg-[#0068ff]" aria-label="Zalo">Z</a>
                <a href="tel:@tel" class="grid h-11 w-11 place-items-center rounded-full bg-white/5 text-white transition hover:-translate-y-1 hover:bg-emerald-500" aria-label="Gọi hotline"><i class="fa-solid fa-phone"></i></a>
                <a href="mailto:@site.Email" class="grid h-11 w-11 place-items-center rounded-full bg-white/5 text-white transition hover:-translate-y-1 hover:bg-cyan-500" aria-label="Email"><i class="fa-solid fa-envelope"></i></a>
            </div>
        </div>
        <div class="md:col-span-3">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Khám phá</h4>
            <ul class="mt-5 space-y-3 text-sm">
                <li><a class="transition hover:text-emerald-400" href="@Url.Action("Fleet", "Home")">Xe cho thuê</a></li>
                <li><a class="transition hover:text-emerald-400" href="@Url.Action("Pricing", "Home")">Tính giá thuê</a></li>
                <li><a class="transition hover:text-emerald-400" href="@Url.Action("Process", "Home")">Quy trình đặt xe</a></li>
                <li><a class="transition hover:text-emerald-400" href="@Url.Action("Lookup", "Booking")">Tra cứu đơn</a></li>
                <li><a class="transition hover:text-emerald-400" href="@Url.Action("Faq", "Home")">Câu hỏi thường gặp</a></li>
            </ul>
        </div>
        <div class="md:col-span-4">
            <h4 class="text-sm font-bold uppercase tracking-wider text-white">Liên hệ</h4>
            <ul class="mt-5 space-y-3 text-sm">
                <li class="flex gap-3"><i class="fa-solid fa-phone mt-1 text-emerald-400"></i> @site.Hotline</li>
                <li class="flex gap-3"><i class="fa-solid fa-envelope mt-1 text-emerald-400"></i> @site.Email</li>
                <li class="flex gap-3"><i class="fa-solid fa-location-dot mt-1 text-emerald-400"></i> @site.Address</li>
            </ul>
        </div>
    </div>
    <div class="relative border-t border-white/10 py-6 text-center text-xs">
        © @DateTime.Now.Year @site.BrandName. Mọi quyền được bảo lưu.
        @if (System.IO.File.Exists(System.IO.Path.Combine(Env.WebRootPath, MoveGo.Web.Controllers.CreditsController.CreditsRelativePath)))
        {
            <span class="mx-1 opacity-40">·</span><a href="@Url.Action("Index", "Credits")" class="underline-offset-2 hover:text-white hover:underline">Nguồn ảnh</a>
        }
    </div>
</footer>

@* Nút nổi: Zalo / Gọi / Lên đầu trang *@
<div class="fixed bottom-5 right-4 z-40 flex flex-col items-end gap-3 sm:right-6">
    <button id="to-top" type="button" class="pointer-events-none grid h-12 w-12 translate-y-4 place-items-center rounded-full bg-white text-ink-900 opacity-0 shadow-lift transition duration-500 hover:bg-emerald-500 hover:text-white" aria-label="Lên đầu trang"><i class="fa-solid fa-arrow-up"></i></button>
    <a href="tel:@tel" class="grid h-12 w-12 place-items-center rounded-full bg-emerald-500 text-white shadow-glow transition hover:scale-110 sm:hidden" aria-label="Gọi hotline"><i class="fa-solid fa-phone"></i></a>
    <a href="https://zalo.me/@site.ZaloPhone" target="_blank" rel="noopener" class="group relative grid h-14 w-14 place-items-center rounded-full bg-[#0068ff] text-lg font-extrabold text-white shadow-[0_14px_34px_-8px_rgb(0,104,255,.7)] transition hover:scale-110" aria-label="Chat Zalo">
        <span class="absolute inset-0 rounded-full bg-[#0068ff] opacity-60" style="animation: ping 2.2s cubic-bezier(0,0,.2,1) infinite"></span>
        <span class="relative">Zalo</span>
    </a>
</div>
