@model VehicleDto
@{
    var hasSearch = ViewData["HasSearch"] as bool? ?? false;
    var delay = (ViewData["Delay"] as int? ?? 0) * 0.07;
    var tone = ViewHelpers.Tone(Model);
    var images = ViewHelpers.ImagesOf(Model);
}
<article class="vcard reveal" data-reveal="up" data-category="@Model.Category" data-vehicle-card data-id="@Model.Id"
         style="--tone:@tone;--d:@(delay.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))s">
    <div class="vcard-art @(images.Length > 0 ? "vcard-art-photo" : "")">
        <span class="absolute left-4 top-4 z-10 inline-flex items-center gap-1.5 rounded-full bg-white/90 px-3 py-1 text-[11px] font-bold text-ink-900 shadow-sm backdrop-blur">
            <i class="fa-solid @ViewHelpers.CategoryIcon(Model.Category)" style="color:@tone"></i> @Model.CategoryLabel
        </span>
        <span class="absolute right-4 top-4 z-10 inline-flex items-center gap-2 rounded-full bg-ink-900/85 px-3 py-1 text-[11px] font-semibold text-white backdrop-blur">
            <i class="dot-live"></i> @(hasSearch ? "Còn trống" : "Sẵn sàng")
        </span>

        @if (images.Length > 0)
        {
            @* Ảnh thật phủ kín khung; bấm vào để xem cả bộ ảnh *@
            <button type="button" class="vcard-photo" data-gallery="@System.Text.Json.JsonSerializer.Serialize(images)" data-gallery-title="@Model.Name"
                    aria-label="Xem @(images.Length) ảnh của @Model.Name">
                <img src="@images[0]" alt="@Model.Name" loading="lazy" />
                <span class="vcard-photo-shade"></span>
                <span class="photo-count"><i class="fa-regular fa-images"></i> @(images.Length > 1 ? $"{images.Length} ảnh" : "Phóng to")</span>
            </button>
        }
        else
        {
            <div class="vcard-vehicle mx-auto mt-8 w-[92%] max-w-[22rem]" style="color:@tone">
                <svg class="art" viewBox="0 0 360 170" role="img" aria-label="@Model.Name"><use href="#@ViewHelpers.ArtId(Model.Category)" /></svg>
            </div>
            <div class="vcard-shadow"></div>
        }
    </div>

    <div class="flex flex-1 flex-col p-6">
        <div class="flex items-start justify-between gap-3">
            <div>
                <h3 class="text-lg font-extrabold leading-tight">@Model.Name</h3>
                <p class="mt-1 flex items-center gap-1.5 text-sm text-slate-500"><i class="fa-solid fa-tag" style="color:@tone"></i> @Model.Brand</p>
            </div>
        </div>

        <div class="mt-4 flex flex-wrap gap-2">
            <span class="chip"><i class="fa-solid fa-user-group text-slate-400"></i> @Model.Seats chỗ</span>
            @if (Model.RangeKm is int km)
            {
                <span class="chip"><i class="fa-solid fa-bolt text-amber-400"></i> Đến @km km/lần sạc</span>
            }
            <span class="chip"><i class="fa-solid fa-leaf text-emerald-500"></i> 100% điện</span>
        </div>

        @if (Model.Highlights.Length > 0)
        {
            <ul class="mt-4 space-y-1.5 text-sm text-slate-500">
                @foreach (var h in Model.Highlights.Take(3))
                {
                    <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-xs" style="color:@tone"></i> @h</li>
                }
            </ul>
        }

        <div class="mt-auto flex items-end justify-between gap-3 pt-6">
            <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Giá thuê / ngày</span>
                <div class="text-2xl font-extrabold text-ink-900">@ViewHelpers.Vnd(Model.PricePerDay)</div>
            </div>
            <button type="button" class="btn-primary btn-sm !px-5 !py-3" data-open-booking="@Model.Id">
                Thuê xe <i class="fa-solid fa-arrow-right transition group-hover:translate-x-1"></i>
            </button>
        </div>
        <button type="button" class="mt-3 text-left text-xs font-semibold text-slate-400 transition hover:text-emerald-600" data-open-booking="@Model.Id" data-focus="calendar">
            <i class="fa-solid fa-calendar-days"></i> Xem lịch trống của xe này
        </button>
    </div>
</article>
