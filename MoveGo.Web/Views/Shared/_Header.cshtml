@inject IOptions<SiteOptions> SiteOpt
@{
    var site = SiteOpt.Value;
    var overlay = ViewData["HeaderMode"] as string == "overlay";   // trang chủ: header trong suốt trên hero
    var home = Url.Action("Index", "Home");
    var fleet = Url.Action("Fleet", "Home");
    var nav = ViewData["Nav"] as string ?? "";
    var items = new[]
    {
        (Key: "home", Label: "Trang chủ", Url: home!),
        (Key: "fleet", Label: "Xe cho thuê", Url: fleet!),
        (Key: "pricing", Label: "Tính giá", Url: Url.Action("Pricing", "Home")!),
        (Key: "process", Label: "Quy trình", Url: Url.Action("Process", "Home")!),
        (Key: "faq", Label: "Hỏi đáp", Url: Url.Action("Faq", "Home")!)
    };
    var tel = new string(site.Hotline.Where(char.IsDigit).ToArray());
}
<header id="site-header" class="site-header @(overlay ? "" : "is-solid") fixed inset-x-0 top-0 z-50 py-3">
    <div class="container-x flex items-center justify-between gap-4">
        <a href="@home" class="group flex items-center gap-2.5" aria-label="@site.BrandName - Trang chủ">
            <img src="~/brand/logo-mark.svg" alt="" width="44" height="44" class="h-11 w-11 rounded-2xl shadow-glow transition duration-500 group-hover:rotate-[-8deg] group-hover:scale-110" />
            <span class="logo-word text-xl font-extrabold tracking-tight">Move<span class="text-orange-400">Go</span></span>
        </a>

        <nav class="hidden items-center gap-1 lg:flex" aria-label="Điều hướng chính">
            @foreach (var it in items)
            {
                <a class="nav-link @(nav == it.Key ? "is-active" : "")" href="@it.Url" aria-current="@(nav == it.Key ? "page" : null)">@it.Label</a>
            }
        </nav>

        <div class="flex items-center gap-3">
            <a href="tel:@tel" class="hotline hidden items-center gap-2 text-sm font-bold md:inline-flex">
                <span class="grid h-9 w-9 place-items-center rounded-full bg-emerald-500/15 text-emerald-500"><i class="fa-solid fa-phone-volume"></i></span>
                @site.Hotline
            </a>
            <a href="@fleet" class="btn-primary btn-sm hidden sm:inline-flex"><i class="fa-solid fa-bolt"></i> Đặt xe</a>
            <button id="burger" type="button" class="burger grid h-11 w-11 place-items-center rounded-full lg:hidden" aria-label="Mở menu" aria-expanded="false" aria-controls="mobile-menu">
                <span class="relative block h-0.5 w-6 rounded bg-ink-900 transition before:absolute before:-top-2 before:left-0 before:h-0.5 before:w-6 before:rounded before:bg-inherit before:transition after:absolute after:left-0 after:top-2 after:h-0.5 after:w-6 after:rounded after:bg-inherit after:transition"></span>
            </button>
        </div>
    </div>

    <div id="mobile-menu" class="hidden px-5 pb-4 pt-3 lg:hidden">
        <div class="glass-light rounded-3xl p-3">
            @foreach (var it in items)
            {
                <a class="block rounded-2xl px-4 py-3 font-semibold hover:bg-emerald-50 @(nav == it.Key ? "bg-emerald-50 text-emerald-700" : "text-ink-900")" href="@it.Url">@it.Label</a>
            }
            <a class="btn-primary mt-2 w-full" href="tel:@tel"><i class="fa-solid fa-phone-volume"></i> Gọi @site.Hotline</a>
        </div>
    </div>
</header>
