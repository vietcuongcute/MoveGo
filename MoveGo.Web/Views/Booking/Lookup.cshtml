@model LookupViewModel
@inject IOptions<SiteOptions> SiteOpt
@{
    ViewData["Title"] = "Tra cứu đơn";
    ViewData["Nav"] = "lookup";
    ViewData["NoIndex"] = true;
    ViewData["BannerIcon"] = "fa-magnifying-glass";
    ViewData["BannerEyebrow"] = "Tra cứu đơn";
    ViewData["BannerTitle"] = "Xem tình trạng";
    ViewData["BannerAccent"] = "đơn thuê xe";
    ViewData["BannerSub"] = "Nhập mã đơn hoặc số điện thoại bạn đã dùng để đặt xe — xem chủ xe đã xác nhận chưa, quét QR cọc 10%, rồi chờ chủ xe nhắn cho bạn.";
    ViewData["BannerPad"] = "pb-36";
    var site = SiteOpt.Value;
    var tel = new string(site.Hotline.Where(char.IsDigit).ToArray());
}

<partial name="_PageBanner" />

<section class="container-x relative z-10 -mt-20 pb-24">
    <div class="mx-auto grid max-w-4xl gap-6 lg:grid-cols-5">
        <div class="panel lg:col-span-3">
            <h2 class="text-xl font-extrabold">Nhập mã đơn hoặc số điện thoại</h2>
            <p class="mt-2 text-sm text-slate-500">Mã đơn có dạng <b class="text-ink-900">MG-K7P2QX</b>. Quên mã? Nhập <b class="text-ink-900">số điện thoại</b> bạn đã dùng khi đặt xe, chúng tôi sẽ liệt kê các đơn của số đó.</p>

            <form method="get" action="@Url.Action("Lookup", "Booking")" class="mt-5 flex flex-col gap-3 sm:flex-row" id="lookup-form">
                <label class="sr-only" for="ma">Mã đơn hoặc số điện thoại</label>
                <input id="ma" name="ma" value="@Model.Input" class="field !py-3.5 text-lg font-bold uppercase tracking-wider" placeholder="MG-K7P2QX hoặc 09xx xxx xxx"
                       autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="20" required autofocus />
                <button type="submit" class="btn-primary btn-lg shrink-0"><i class="fa-solid fa-magnifying-glass"></i> Tra cứu</button>
            </form>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <p class="mt-3 flex items-start gap-2 rounded-2xl bg-red-50 p-3 text-sm font-semibold text-red-600" role="alert"><i class="fa-solid fa-circle-exclamation mt-0.5"></i><span>@Model.Error</span></p>
            }

            @if (Model.PhoneResults is { } found)
            {
                <div class="mt-6" id="phone-results">
                    @if (found.Count == 0)
                    {
                        <div class="rounded-2xl bg-slate-50 p-4 text-sm text-slate-600">
                            <div class="font-bold text-ink-900"><i class="fa-regular fa-face-frown mr-1 text-slate-400"></i> Chưa thấy đơn nào với số này</div>
                            <p class="mt-1">Chỉ tìm được các đơn trong 6 tháng gần đây. Hãy kiểm tra lại số điện thoại hoặc gọi hotline <a class="font-bold text-emerald-600" href="tel:@tel">@site.Hotline</a> để được hỗ trợ.</p>
                        </div>
                    }
                    else
                    {
                        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">@found.Count đơn tìm thấy</div>
                        <ul class="mt-3 space-y-2">
                            @foreach (var o in found)
                            {
                                var (cls, icon) = ViewHelpers.StatusBadge(o.Status);
                                <li>
                                    <a href="@Url.Action("Track", "Booking", new { code = o.Code })" class="group flex items-center gap-3 rounded-2xl border border-slate-200 bg-white p-3.5 transition hover:border-emerald-400 hover:shadow-soft">
                                        <div class="min-w-0 flex-1">
                                            <div class="flex flex-wrap items-center gap-2">
                                                <span class="font-extrabold tracking-wider text-ink-900">@o.Code</span>
                                                <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-bold @cls"><i class="fa-solid @icon text-[10px]"></i> @ViewHelpers.StatusLabel(o.Status)</span>
                                            </div>
                                            <div class="mt-1 truncate text-sm font-semibold text-slate-700">@o.VehicleName</div>
                                            <div class="text-xs text-slate-400">@o.StartDate.ToString("dd/MM/yyyy") – @o.EndDate.ToString("dd/MM/yyyy") · @ViewHelpers.Vnd(o.TotalAmount)</div>
                                        </div>
                                        <i class="fa-solid fa-arrow-right text-emerald-500 transition group-hover:translate-x-0.5"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }

            <div id="recent" class="mt-7 hidden">
                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Đơn gần đây trên thiết bị này</div>
                <ul id="recent-list" class="mt-3 space-y-2"></ul>
            </div>
        </div>

        <aside class="panel lg:col-span-2">
            <h3 class="text-base font-extrabold">Không thấy mã đơn?</h3>
            <ul class="mt-4 space-y-3 text-sm text-slate-500">
                <li class="flex gap-3"><i class="fa-solid fa-mobile-screen mt-0.5 text-emerald-500"></i><span>Quên mã? Nhập đúng số điện thoại đã điền lúc đặt xe để xem lại các đơn của bạn.</span></li>
                <li class="flex gap-3"><i class="fa-solid fa-comment-dots mt-0.5 text-emerald-500"></i><span>Mã được hiện ngay sau khi bạn gửi yêu cầu thuê xe và nằm trong link theo dõi đơn.</span></li>
                <li class="flex gap-3"><i class="fa-solid fa-clock-rotate-left mt-0.5 text-emerald-500"></i><span>Đơn quá hạn cọc sẽ tự huỷ, mã vẫn tra cứu được để xem trạng thái.</span></li>
                <li class="flex gap-3"><i class="fa-solid fa-phone-volume mt-0.5 text-emerald-500"></i><span>Cần hỗ trợ? Gọi <a class="font-bold text-emerald-600" href="tel:@tel">@site.Hotline</a>.</span></li>
            </ul>
        </aside>
    </div>
</section>

@section Scripts {
    <script src="~/js/lookup.js" asp-append-version="true"></script>
}
