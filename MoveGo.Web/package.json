{
  "name": "movego-web",
  "private": true,
  "version": "1.0.0",
  "description": "Build Tailwind CSS + sao chép thư viện front-end cho MoveGo.Web",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "css": "tailwindcss -c tailwind.config.js -i Styles/tailwind.css -o wwwroot/css/site.css --minify",
    "css:watch": "tailwindcss -c tailwind.config.js -i Styles/tailwind.css -o wwwroot/css/site.css --watch",
    "build": "npm run vendor && npm run css"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.1.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "flatpickr": "^4.6.13",
    "qrcode-generator": "^1.4.4",
    "tailwindcss": "^3.4.17"
  }
}
